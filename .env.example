# छाया AI — Environment Variables (उदाहरण फाईल, यात खरी Key टाकू नका)
#
# ही फाईल फक्त REFERENCE साठी आहे — याची कॉपी करून ".env.local" नावाने
# save करा आणि तिथे खऱ्या keys टाका. ".env.local" कधीही GitHub वर push
# होणार नाही (.gitignore मध्ये आधीच वगळलेली आहे).
#
# असली/production keys नेहमी Vercel Dashboard मध्येच टाका:
# Vercel → तुमचा Project → Settings → Environment Variables

# Google Gemini AI (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Live APMC/Mandi Price — data.gov.in (https://data.gov.in)
MARKET_API_KEY=
MARKET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# ElevenLabs Text-to-Speech (https://elevenlabs.io)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
